local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = false

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)

local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local BlocksData =
    require(Rs.Shared.Info.MiningInfo.Blocks)

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksFolder =
    workspace.Maps.Mining.Blocks


------------------------------------------------------------
-- PRIORITY ORES / CHESTS
------------------------------------------------------------

local PriorityBlocks = {

    PinkydreamyOre = true,
    LuminiteOre = true,
    FrostOre = true,

    LootChest4 = true,
    LootChest3 = true,
    LootChest2 = true,
    LootChest1 = true,

    GlitchedOre = true,
    PrismiteOre = true,
    AbyssaliteOre = true,

}


------------------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId then
        return nil
    end

    if blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


------------------------------------------------------------
-- GET COORDINATES FROM BLOCK NAME
------------------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x or not y or not z then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)

end


------------------------------------------------------------
-- GET BLOCK AT COORDINATE
------------------------------------------------------------

local function getBlockAtCoordinate(x, y, z)

    local blockName =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return BlocksFolder:FindFirstChild(blockName)

end


------------------------------------------------------------
-- CHECK BEDROCK
------------------------------------------------------------

local function isBedrock(block)

    if not block then
        return true
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
        or info.Name == "Bedrock"

end


------------------------------------------------------------
-- MINE BLOCK
------------------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block

    MiningServiceClient:damageBlock()

    return true

end


------------------------------------------------------------
-- MINE ONE BLOCK UNTIL DESTROYED
------------------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return false
    end

    if isBedrock(block) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            break
        end

        mineBlock(block)

        task.wait()

    end

    return true

end


------------------------------------------------------------
-- GO STRAIGHT DOWN
------------------------------------------------------------

local function mineDownTo800()

    --------------------------------------------------------
    -- START
    -- 9_0_9
    -- 9_-1_9
    -- 9_-2_9
    -- ...
    -- 9_-800_9
    --------------------------------------------------------

    for y = 0, -800, -1 do

        if not G.Settings["Auto Mine"] then
            return false
        end

        local block =
            getBlockAtCoordinate(
                9,
                y,
                9
            )

        ----------------------------------------------------
        -- NO BLOCK = SKIP
        ----------------------------------------------------

        if block then

            if not isBedrock(block) then

                mineUntilDestroyed(block)

            end

        end

    end

    return true

end


------------------------------------------------------------
-- GET BLOCKS AT DEPTH
------------------------------------------------------------

local function getBlocksAtDepth(depth)

    local priority = {}
    local normal = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z =
                getBlockCoordinates(block)

            if y == depth then

                local info =
                    getBlockInfo(block)

                if info
                    and info.Id ~= "Bedrock"
                    and info.Name ~= "Bedrock" then

                    if PriorityBlocks[info.Id]
                        or PriorityBlocks[info.Name] then

                        table.insert(
                            priority,
                            block
                        )

                    else

                        table.insert(
                            normal,
                            block
                        )

                    end

                end

            end

        end

    end

    return priority, normal

end


------------------------------------------------------------
-- MINE 10 BLOCKS AT CURRENT DEPTH
------------------------------------------------------------

local function mineLayer(depth)

    local mined = 0

    while mined < 10
        and G.Settings["Auto Mine"] do

        local priority, normal =
            getBlocksAtDepth(depth)

        local target

        ----------------------------------------------------
        -- PRIORITY FIRST
        ----------------------------------------------------

        if #priority > 0 then

            target =
                priority[
                    math.random(
                        1,
                        #priority
                    )
                ]

        elseif #normal > 0 then

            target =
                normal[
                    math.random(
                        1,
                        #normal
                    )
                ]

        else

            -- Nothing on this layer
            return

        end

        ----------------------------------------------------
        -- NEVER MINE BEDROCK
        ----------------------------------------------------

        if target
            and not isBedrock(target) then

            local _, targetY =
                getBlockCoordinates(target)

            if targetY == depth then

                mineUntilDestroyed(target)

                mined += 1

            end

        end

        task.wait()

    end

end


------------------------------------------------------------
-- RANDOM MINING DOWNWARD
------------------------------------------------------------

local function randomMineDown()

    local depth = -800

    --------------------------------------------------------
    -- BEDROCK IS AT -5000
    -- NEVER ATTEMPT TO MINE -5000
    --------------------------------------------------------

    while depth > -5000
        and G.Settings["Auto Mine"] do

        ----------------------------------------------------
        -- MINE 10 BLOCKS
        ----------------------------------------------------

        mineLayer(depth)

        if not G.Settings["Auto Mine"] then
            return
        end

        ----------------------------------------------------
        -- GO DOWN ONE LAYER
        ----------------------------------------------------

        depth -= 1

        task.wait()

    end

end


------------------------------------------------------------
-- AUTO MINE
------------------------------------------------------------

tabMain:addToggle(
    "Auto Mine",
    {
        Title = "Auto Mine",
        Default = false
    },
    function(value)

        G.Settings["Auto Mine"] = value

        if value then

            task.spawn(function()

                ------------------------------------------------
                -- FIRST GO FROM 0 TO -800
                ------------------------------------------------

                local reached800 =
                    mineDownTo800()

                if not reached800 then
                    return
                end

                if not G.Settings["Auto Mine"] then
                    return
                end

                ------------------------------------------------
                -- THEN RANDOM MINE
                -- 10 EACH LAYER
                ------------------------------------------------

                randomMineDown()

            end)

        end

    end
)
