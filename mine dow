local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = true

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksFolder =
    workspace.Maps.Mining.Blocks


------------------------------------------------------------
-- PRIORITY ORES / CHESTS
------------------------------------------------------------

local PriorityBlocks = {
    PinkydreamyOre = true,
    LuminiteOre = true,
    FrostOre = true,

    LootChest4 = true,
    LootChest3 = true,
    LootChest2 = true,
    LootChest1 = true,

    GlitchedOre = true,
    PrismiteOre = true,
    AbyssaliteOre = true,
}


------------------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[block.Name]

    if not data then
        return nil
    end

    local id = data[1]

    if not id or id == "None" then
        return nil
    end

    local info = MiningInfo:getBlock(id)

    if not info then
        return nil
    end

    return {
        Id = id,
        Name = info.name
    }

end


------------------------------------------------------------
-- GET COORDINATES
------------------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)

end


------------------------------------------------------------
-- GET BLOCK
------------------------------------------------------------

local function getBlock(x, y, z)

    return BlocksFolder:FindFirstChild(
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)
    )

end


------------------------------------------------------------
-- BEDROCK CHECK
------------------------------------------------------------

local function isBedrock(block)

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
        or info.Name == "Bedrock"

end


------------------------------------------------------------
-- MINE BLOCK
------------------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end


------------------------------------------------------------
-- MINE UNTIL DESTROYED
------------------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            return
        end

        mineBlock(block)

        task.wait()

    end

end


------------------------------------------------------------
-- GO FROM 0 TO -800
------------------------------------------------------------

for y = 0, -800, -1 do

    if not G.Settings["Auto Mine"] then
        return
    end

    local block =
        getBlock(9, y, 9)

    -- Skip if there is no block
    if block then

        -- Never mine Bedrock
        if not isBedrock(block) then
            mineUntilDestroyed(block)
        end

    end

end


------------------------------------------------------------
-- PRIORITY CHECK
------------------------------------------------------------

local function getBlocksAtDepth(depth)

    local priority = {}
    local normal = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z =
                getCoordinates(block)

            if y == depth then

                local info =
                    getBlockInfo(block)

                if info
                    and not isBedrock(block) then

                    if PriorityBlocks[info.Id]
                        or PriorityBlocks[info.Name] then

                        table.insert(
                            priority,
                            block
                        )

                    else

                        table.insert(
                            normal,
                            block
                        )

                    end

                end

            end

        end

    end

    return priority, normal

end


------------------------------------------------------------
-- MINE 10 BLOCKS AT EACH DEPTH
------------------------------------------------------------

local depth = -800

while G.Settings["Auto Mine"] do

    local mined = 0

    while mined < 10
        and G.Settings["Auto Mine"] do

        local priority, normal =
            getBlocksAtDepth(depth)

        local target

        -- PRIORITY ORE FIRST
        if #priority > 0 then

            target =
                priority[
                    math.random(
                        1,
                        #priority
                    )
                ]

        -- OTHERWISE RANDOM NORMAL BLOCK
        elseif #normal > 0 then

            target =
                normal[
                    math.random(
                        1,
                        #normal
                    )
                ]

        else

            -- Nothing at this depth
            break

        end

        if target
            and not isBedrock(target) then

            local _, targetY =
                getCoordinates(target)

            if targetY == depth then

                mineUntilDestroyed(target)

                mined += 1

            end

        end

        task.wait()

    end

    -- Go down one layer
    depth -= 1

    -- Never attempt Bedrock at -5000
    if depth <= -5000 then
        break
    end

    task.wait()

end
