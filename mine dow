-- AUTO MINE TOGGLE
------------------------------------------------

local AutoMine =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine",
            Default = false
        }
    )

AutoMine:OnChanged(function(value)

    G.Settings["Auto Mine"] = value

    if value then

        task.spawn(function()

            ------------------------------------------------
            -- GO TO -800
            ------------------------------------------------

            local reached =
                mineDownTo800()

            if not reached then
                return
            end

            if not G.Settings["Auto Mine"] then
                return
            end

            ------------------------------------------------
            -- IMPORTANT:
            -- ACTUALLY FORCE THE MOVE TO -802
            ------------------------------------------------

            local firstMove =
                forceDownToDepth(
                    FIRST_MINE_DEPTH
                )

            if not firstMove then
                return
            end

            if not G.Settings["Auto Mine"] then
                return
            end

            ------------------------------------------------
            -- START:
            -- -802 → -804 → -806...
            ------------------------------------------------

            randomMineDown()

        end)
    end
end)

