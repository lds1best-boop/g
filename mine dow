            ------------------------------------------------

            local reached =
                mineDownTo800()

            if not reached then
                return
            end

            if not G.Settings["Auto Mine"] then
                return
            end

            ------------------------------------------------
            -- RANDOM MINING
            ------------------------------------------------

            randomMineDown()

        end)

    end

end)

