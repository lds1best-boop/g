local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = true

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksFolder =
    workspace.Maps.Mining.Blocks


------------------------------------------------------------
-- STRICT PRIORITY ORDER
------------------------------------------------------------

local PriorityOrder = {
    "AbyssaliteOre",
    "PrismiteOre",
    "GlitchedOre",
    "LuminiteOre",
    "FrostOre",
    "PinkydreamyOre",

    "LootChest1",
    "LootChest2",
    "LootChest3",
    "LootChest4"
}


------------------------------------------------------------
-- PRIORITY LOOKUP
------------------------------------------------------------

local PriorityRank = {}

for i, name in ipairs(PriorityOrder) do
    PriorityRank[name] = i
end


------------------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[block.Name]

    if not data then
        return nil
    end

    local id = data[1]

    if not id or id == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(id)

    if not info then
        return nil
    end

    return {
        Id = id,
        Name = info.name
    }

end


------------------------------------------------------------
-- GET COORDINATES
------------------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)

end


------------------------------------------------------------
-- GET BLOCK
------------------------------------------------------------

local function getBlock(x, y, z)

    return BlocksFolder:FindFirstChild(
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)
    )

end


------------------------------------------------------------
-- NEVER MINE BEDROCK
------------------------------------------------------------

local function isBedrock(block)

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
        or info.Name == "Bedrock"

end


------------------------------------------------------------
-- MINE BLOCK
------------------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end


------------------------------------------------------------
-- MINE UNTIL DESTROYED
------------------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            return
        end

        mineBlock(block)

        task.wait()

    end

end


------------------------------------------------------------
-- GO STRAIGHT DOWN TO -800
------------------------------------------------------------

for y = 0, -800, -1 do

    if not G.Settings["Auto Mine"] then
        return
    end

    local block =
        getBlock(9, y, 9)

    if block and not isBedrock(block) then

        mineUntilDestroyed(block)

    end

end


------------------------------------------------------------
-- FIND BLOCKS AT CURRENT DEPTH
------------------------------------------------------------

local function getBlocksAtDepth(depth)

    local priorityBlocks = {}
    local normalBlocks = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z =
                getCoordinates(block)

            if y == depth then

                local info =
                    getBlockInfo(block)

                if info
                    and not isBedrock(block) then

                    local rank =
                        PriorityRank[info.Id]

                    if rank then

                        table.insert(
                            priorityBlocks,
                            {
                                Block = block,
                                Rank = rank
                            }
                        )

                    else

                        table.insert(
                            normalBlocks,
                            block
                        )

                    end

                end

            end

        end

    end

    --------------------------------------------------------
    -- SORT BY YOUR EXACT PRIORITY
    --------------------------------------------------------

    table.sort(
        priorityBlocks,
        function(a, b)
            return a.Rank < b.Rank
        end
    )

    return priorityBlocks, normalBlocks

end


------------------------------------------------------------
-- MINE EACH DEPTH
------------------------------------------------------------

local depth = -800

while G.Settings["Auto Mine"] do

    local mined = 0

    --------------------------------------------------------
    -- FIRST MINE PRIORITY BLOCKS
    --------------------------------------------------------

    while G.Settings["Auto Mine"] do

        local priorityBlocks, normalBlocks =
            getBlocksAtDepth(depth)

        if #priorityBlocks == 0 then
            break
        end

        -- ALWAYS TAKE THE HIGHEST PRIORITY AVAILABLE
        local target =
            priorityBlocks[1].Block

        if target
            and target.Parent
            and not isBedrock(target) then

            mineUntilDestroyed(target)

            mined += 1

        else

            break

        end

        task.wait()

    end


    --------------------------------------------------------
    -- THEN MINE NORMAL BLOCKS UNTIL 10 TOTAL
    --------------------------------------------------------

    while mined < 10
        and G.Settings["Auto Mine"] do

        local priorityBlocks, normalBlocks =
            getBlocksAtDepth(depth)

        -- If a priority appeared, go back to priority
        if #priorityBlocks > 0 then
            break
        end

        if #normalBlocks == 0 then
            break
        end

        local target =
            normalBlocks[
                math.random(
                    1,
                    #normalBlocks
                )
            ]

        if target
            and target.Parent
            and not isBedrock(target) then

            mineUntilDestroyed(target)

            mined += 1

        end

        task.wait()

    end


    --------------------------------------------------------
    -- NEXT DEPTH
    --------------------------------------------------------

    depth -= 1

    --------------------------------------------------------
    -- NEVER MINE BEDROCK
    --------------------------------------------------------

    if depth <= -5000 then
        break
    end

    task.wait()

end
