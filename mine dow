------------------------------------------------
-- PRIORITY ORDER
------------------------------------------------

local PriorityOrder = {
    "AbyssaliteOre",
    "PrismiteOre",
    "GlitchedOre",
    "LuminiteOre",
    "FrostOre",
    "PinkydreamyOre",
    "LootChest1",
    "LootChest2",
    "LootChest3",
    "LootChest4"
}

local PriorityRank = {}

for i, name in ipairs(PriorityOrder) do
    PriorityRank[name] = i
end

------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[block.Name]

    if not data then
        return nil
    end

    local id = data[1]

    if not id or id == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(id)

    if not info then
        return nil
    end

    return {
        Id = id,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }
end

------------------------------------------------
-- GET COORDINATES
------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)
end

------------------------------------------------
-- GET BLOCK
------------------------------------------------

local function getBlock(x, y, z)

    return BlocksFolder:FindFirstChild(
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)
    )
end

------------------------------------------------
-- BEDROCK CHECK
------------------------------------------------

local function isBedrock(block)

    if not block then
        return true
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
        or info.Name == "Bedrock"
end

------------------------------------------------
-- PRIORITY
------------------------------------------------

local function getPriorityRank(block)

    local info =
        getBlockInfo(block)

    if not info then
        return nil
    end

    return PriorityRank[info.Id]
        or PriorityRank[info.Name]
end

------------------------------------------------
-- MINE BLOCK
------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true
end

------------------------------------------------
-- MINE UNTIL DESTROYED
------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return false
    end

    if isBedrock(block) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            return false
        end

        mineBlock(block)

        task.wait()
    end

    return true
end

------------------------------------------------
-- FIND PRIORITY
------------------------------------------------

local function findPriorityBlock()

    local bestBlock = nil
    local bestRank = math.huge

    for _, block in ipairs(
        BlocksFolder:GetChildren()
    ) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local rank =
                getPriorityRank(block)

            if rank
                and rank < bestRank then

                bestRank = rank
                bestBlock = block
            end
        end
    end

    return bestBlock
end

------------------------------------------------
-- FORCE DOWN TO DEPTH
--
-- This does NOT assume we moved.
-- It checks the target block after every
-- attempt and keeps trying until the
-- target depth is actually reached.
------------------------------------------------

local function forceDownToDepth(targetDepth)

    while G.Settings["Auto Mine"] do

        ------------------------------------------------
        -- CHECK TARGET BLOCK
        ------------------------------------------------

        local target =
            getBlock(
                START_X,
                targetDepth,
                START_Z
            )

        ------------------------------------------------
        -- TARGET DOES NOT EXIST
        -- We have reached/passed it.
        ------------------------------------------------

        if not target then
            return true
        end

        ------------------------------------------------
        -- BEDROCK SAFETY
        ------------------------------------------------

        if isBedrock(target) then
            return false
        end

        ------------------------------------------------
        -- MINE TARGET
        ------------------------------------------------

        mineUntilDestroyed(target)

        task.wait()

        ------------------------------------------------
        -- CHECK AGAIN
        ------------------------------------------------

        local check =
            getBlock(
                START_X,
                targetDepth,
                START_Z
            )

        if not check then
            return true
        end

        ------------------------------------------------
        -- IF STILL THERE, KEEP TRYING
        ------------------------------------------------

        task.wait()
    end

    return false
end

------------------------------------------------
-- GO DOWN TO -800
------------------------------------------------

local function mineDownTo800()

    for y = 0, START_DEPTH, -1 do

        if not G.Settings["Auto Mine"] then
            return false
        end

        ------------------------------------------------
        -- PRIORITY
        ------------------------------------------------

        local priority =
            findPriorityBlock()

        if priority then
            mineUntilDestroyed(priority)
        end

        if not G.Settings["Auto Mine"] then
            return false
        end

        ------------------------------------------------
        -- MINE VERTICAL PATH
        ------------------------------------------------

        local block =
            getBlock(
                START_X,
                y,
                START_Z
            )

        if block then

            if not isBedrock(block) then
                mineUntilDestroyed(block)
            else
                return false
            end

        end

        task.wait()
    end

    return true
end

------------------------------------------------
-- GET BLOCKS AT DEPTH
------------------------------------------------

local function getBlocksAtDepth(depth)

    local priorityBlocks = {}
    local normalBlocks = {}

    for _, block in ipairs(
        BlocksFolder:GetChildren()
    ) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local x, y, z =
                getCoordinates(block)

            if y == depth then

                local rank =
                    getPriorityRank(block)

                if rank then

                    table.insert(
                        priorityBlocks,
                        {
                            Block = block,
                            Rank = rank
                        }
                    )

                else

                    table.insert(
                        normalBlocks,
                        block
                    )

                end
            end
        end
    end

    ------------------------------------------------
    -- PRIORITY ORDER
    ------------------------------------------------

    table.sort(
        priorityBlocks,
        function(a, b)
            return a.Rank < b.Rank
        end
    )

    return priorityBlocks, normalBlocks
end

------------------------------------------------
-- MINE 100 BLOCKS
------------------------------------------------

local function mineLayer(depth)

    local mined = 0

    while mined < BLOCKS_PER_LAYER
        and G.Settings["Auto Mine"] do

        ------------------------------------------------
        -- GLOBAL PRIORITY
        ------------------------------------------------

        local globalPriority =
            findPriorityBlock()

        if globalPriority then

            mineUntilDestroyed(
                globalPriority
            )

            task.wait()

        else

            ------------------------------------------------
            -- GET CURRENT LAYER
            ------------------------------------------------

            local priorityBlocks,
                  normalBlocks =
                getBlocksAtDepth(depth)

            ------------------------------------------------
            -- PRIORITY BLOCK
            ------------------------------------------------

            if #priorityBlocks > 0 then

                local target =
                    priorityBlocks[1].Block

                if target
                    and target.Parent
                    and not isBedrock(target) then

                    mineUntilDestroyed(
                        target
                    )

                    mined += 1
                end

            ------------------------------------------------
            -- RANDOM BLOCK
            ------------------------------------------------

            elseif #normalBlocks > 0 then

                local target =
                    normalBlocks[
                        math.random(
                            1,
                            #normalBlocks
                        )
                    ]

                if target
                    and target.Parent
                    and not isBedrock(target) then

                    mineUntilDestroyed(
                        target
                    )

                    mined += 1
                end

            else

                break
            end
        end

        task.wait()
    end

    return mined
end

------------------------------------------------
-- RANDOM MINING
--
-- -802
-- -804
-- -806
-- -808
-- ...
------------------------------------------------

local function randomMineDown()

    local depth =
        FIRST_MINE_DEPTH

    while depth >= MAX_DEPTH
        and G.Settings["Auto Mine"] do

        ------------------------------------------------
        -- PRIORITY FIRST
        ------------------------------------------------

        local priority =
            findPriorityBlock()

        if priority then

            mineUntilDestroyed(
                priority
            )

        else

            ------------------------------------------------
            -- MAKE SURE WE ARE ACTUALLY
            -- AT THIS DEPTH BEFORE MINING
            ------------------------------------------------

            local reached =
                forceDownToDepth(depth)

            if not reached then
                return
            end

            if not G.Settings["Auto Mine"] then
                return
            end

            ------------------------------------------------
            -- VERIFY TARGET DEPTH
            ------------------------------------------------

            local verify =
                getBlock(
                    START_X,
                    depth,
                    START_Z
                )

            ------------------------------------------------
            -- If block still exists, we are
            -- at this depth and can mine it.
            ------------------------------------------------

            if verify then

                if isBedrock(verify) then
                    return
                end

            end

            ------------------------------------------------
            -- MINE 100 BLOCKS
            ------------------------------------------------

            mineLayer(depth)

            ------------------------------------------------
            -- NEXT TARGET IS 2 LAYERS DOWN
            ------------------------------------------------

            local nextDepth =
                depth - DEPTH_STEP

            ------------------------------------------------
            -- FORCE THE 2-LAYER MOVE
            ------------------------------------------------

            if nextDepth >= MAX_DEPTH then

                local moved =
                    forceDownToDepth(
                        nextDepth
                    )

                if not moved then
                    return
                end
            end

            ------------------------------------------------
            -- NEXT LAYER
            ------------------------------------------------

            depth = nextDepth
        end

        task.wait()
    end
end

