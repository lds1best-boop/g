local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = true

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksFolder =
    workspace.Maps.Mining.Blocks


------------------------------------------------------------
-- SETTINGS
------------------------------------------------------------

local START_X = 9
local START_Z = 9

local START_Y = 0
local RANDOM_START_Y = -800

local BLOCKS_PER_LAYER = 100

-- Do not ever mine this depth or below
local BEDROCK_DEPTH = -5000


------------------------------------------------------------
-- STRICT PRIORITY
------------------------------------------------------------

local PriorityOrder = {
    "AbyssaliteOre",
    "PrismiteOre",
    "GlitchedOre",
    "LuminiteOre",
    "FrostOre",
    "PinkydreamyOre",
    "LootChest1",
    "LootChest2",
    "LootChest3",
    "LootChest4"
}

local PriorityRank = {}

for i, name in ipairs(PriorityOrder) do
    PriorityRank[name] = i
end


------------------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[block.Name]

    if not data then
        return nil
    end

    local blockId = data[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


------------------------------------------------------------
-- GET COORDINATES
------------------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)

end


------------------------------------------------------------
-- GET BLOCK BY COORDINATE
------------------------------------------------------------

local function getBlock(x, y, z)

    return BlocksFolder:FindFirstChild(
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)
    )

end


------------------------------------------------------------
-- NEVER MINE BEDROCK
------------------------------------------------------------

local function isBedrock(block)

    if not block then
        return true
    end

    local info = getBlockInfo(block)

    if info then

        if info.Id == "Bedrock"
            or info.Name == "Bedrock" then

            return true

        end

    end

    -- Extra safety check
    if string.find(
        string.lower(block.Name),
        "bedrock"
    ) then

        return true

    end

    local _, y =
        getCoordinates(block)

    if y and y <= BEDROCK_DEPTH then
        return true
    end

    return false

end


------------------------------------------------------------
-- MINE BLOCK
------------------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end


------------------------------------------------------------
-- MINE UNTIL DESTROYED
------------------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return false
    end

    if isBedrock(block) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            return false
        end

        mineBlock(block)

        task.wait()

    end

    return true

end


------------------------------------------------------------
-- FIND HIGHEST PRIORITY BLOCK
--
-- Searches the whole mine, not just the current layer.
------------------------------------------------------------

local function findPriorityBlock()

    local bestBlock = nil
    local bestRank = math.huge

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local info = getBlockInfo(block)

            if info then

                local rank =
                    PriorityRank[info.Id]

                if rank and rank < bestRank then

                    local _, y =
                        getCoordinates(block)

                    if y
                        and y > BEDROCK_DEPTH then

                        bestBlock = block
                        bestRank = rank

                    end

                end

            end

        end

    end

    return bestBlock

end


------------------------------------------------------------
-- HANDLE PRIORITY
------------------------------------------------------------

local function handlePriority()

    while G.Settings["Auto Mine"] do

        local target =
            findPriorityBlock()

        if not target then
            return false
        end

        if isBedrock(target) then
            return false
        end

        -- Mine the highest priority target
        mineUntilDestroyed(target)

        task.wait()

    end

    return true

end


------------------------------------------------------------
-- GO DOWN TO -800
--
-- Before every downward step, check for priority.
------------------------------------------------------------

local function mineDownTo800()

    for y = START_Y, RANDOM_START_Y, -1 do

        if not G.Settings["Auto Mine"] then
            return false
        end

        ----------------------------------------------------
        -- PRIORITY ALWAYS INTERRUPTS DOWNWARD MINING
        ----------------------------------------------------

        local priority =
            findPriorityBlock()

        if priority then

            handlePriority()

            if not G.Settings["Auto Mine"] then
                return false
            end
        end

        ----------------------------------------------------
        -- MINE THE VERTICAL BLOCK
        ----------------------------------------------------

        local block =
            getBlock(
                START_X,
                y,
                START_Z
            )

        -- Missing block = skip
        if block then

            if not isBedrock(block) then

                mineUntilDestroyed(block)

            end

        end

    end

    return true

end


------------------------------------------------------------
-- GET RANDOM BLOCKS AT ONE LAYER
------------------------------------------------------------

local function getNormalBlocksAtDepth(depth)

    local blocks = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local x, y, z =
                getCoordinates(block)

            if y == depth then

                local info =
                    getBlockInfo(block)

                if info
                    and not PriorityRank[info.Id] then

                    table.insert(
                        blocks,
                        block
                    )

                end

            end

        end

    end

    return blocks

end


------------------------------------------------------------
-- MINE 100 BLOCKS AT ONE LAYER
------------------------------------------------------------

local function mineLayer(depth)

    local mined = 0

    while mined < BLOCKS_PER_LAYER
        and G.Settings["Auto Mine"] do

        ----------------------------------------------------
        -- PRIORITY CAN INTERRUPT AT ANY TIME
        ----------------------------------------------------

        local priority =
            findPriorityBlock()

        if priority then

            handlePriority()

            if not G.Settings["Auto Mine"] then
                return
            end

            -- Re-check before normal mining
            continue
        end

        ----------------------------------------------------
        -- GET NORMAL BLOCKS
        ----------------------------------------------------

        local normalBlocks =
            getNormalBlocksAtDepth(depth)

        if #normalBlocks == 0 then
            break
        end

        ----------------------------------------------------
        -- RANDOM NORMAL BLOCK
        ----------------------------------------------------

        local target =
            normalBlocks[
                math.random(
                    1,
                    #normalBlocks
                )
            ]

        if target
            and target.Parent
            and not isBedrock(target) then

            mineUntilDestroyed(target)

            mined += 1

        end

        task.wait()

    end

end


------------------------------------------------------------
-- START RANDOM MINING
------------------------------------------------------------

local depth = RANDOM_START_Y

while G.Settings["Auto Mine"]
    and depth > BEDROCK_DEPTH do

    --------------------------------------------------------
    -- PRIORITY BEFORE EACH LAYER
    --------------------------------------------------------

    handlePriority()

    if not G.Settings["Auto Mine"] then
        break
    end

    --------------------------------------------------------
    -- MINE 100 NORMAL BLOCKS
    --------------------------------------------------------

    mineLayer(depth)

    if not G.Settings["Auto Mine"] then
        break
    end

    --------------------------------------------------------
    -- GO DOWN ONE LAYER
    --------------------------------------------------------

    depth -= 1

    task.wait()

end
