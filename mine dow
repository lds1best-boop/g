------------------------------------------------------------
-- PRIORITY ORDER
------------------------------------------------------------

local PriorityOrder = {
    "AbyssaliteOre",
    "PrismiteOre",
    "GlitchedOre",
    "LuminiteOre",
    "FrostOre",
    "PinkydreamyOre",

    "LootChest1",
    "LootChest2",
    "LootChest3",
    "LootChest4"
}

local PriorityRank = {}

for i, name in ipairs(PriorityOrder) do
    PriorityRank[name] = i
end

------------------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[block.Name]

    if not data then
        return nil
    end

    local id = data[1]

    if not id or id == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(id)

    if not info then
        return nil
    end

    return {
        Id = id,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end

------------------------------------------------------------
-- GET COORDINATES
------------------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)

end

------------------------------------------------------------
-- GET BLOCK
------------------------------------------------------------

local function getBlock(x, y, z)

    return BlocksFolder:FindFirstChild(
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)
    )

end

------------------------------------------------------------
-- BEDROCK CHECK
------------------------------------------------------------

local function isBedrock(block)

    if not block then
        return true
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
        or info.Name == "Bedrock"

end

------------------------------------------------------------
-- GET PRIORITY
------------------------------------------------------------

local function getPriorityRank(block)

    local info = getBlockInfo(block)

    if not info then
        return nil
    end

    return PriorityRank[info.Id]
        or PriorityRank[info.Name]

end

------------------------------------------------------------
-- MINE BLOCK
------------------------------------------------------------

local function mineBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    -- NEVER MINE BEDROCK
    if isBedrock(block) then
        return false
    end

    if not MiningServiceClient.mineFolder then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end

------------------------------------------------------------
-- MINE UNTIL DESTROYED
------------------------------------------------------------

local function mineUntilDestroyed(block)

    if not block then
        return false
    end

    if isBedrock(block) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if isBedrock(block) then
            return false
        end

        mineBlock(block)

        task.wait()

    end

    return true

end

------------------------------------------------------------
-- FIND HIGHEST PRIORITY BLOCK
------------------------------------------------------------

local function findPriorityBlock()

    local bestBlock = nil
    local bestRank = math.huge

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local rank =
                getPriorityRank(block)

            if rank and rank < bestRank then

                bestRank = rank
                bestBlock = block

            end

        end

    end

    return bestBlock

end

------------------------------------------------------------
-- HANDLE PRIORITY
------------------------------------------------------------

local function handlePriority()

    while G.Settings["Auto Mine"] do

        local priority =
            findPriorityBlock()

        if not priority then
            return false
        end

        if priority.Parent
            and not isBedrock(priority) then

            mineUntilDestroyed(priority)

        else
            return false
        end

        task.wait()

    end

    return true

end

------------------------------------------------------------
-- GO DOWN TO -800
------------------------------------------------------------

local function mineDownTo800()

    for y = 0, -800, -1 do

        if not G.Settings["Auto Mine"] then
            return false
        end

        ----------------------------------------------------
        -- PRIORITY ALWAYS INTERRUPTS GOING DOWN
        ----------------------------------------------------

        handlePriority()

        if not G.Settings["Auto Mine"] then
            return false
        end

        ----------------------------------------------------
        -- BLOCK DIRECTLY BELOW
        ----------------------------------------------------

        local block =
            getBlock(9, y, 9)

        if block then

            if not isBedrock(block) then
                mineUntilDestroyed(block)
            end

        end

    end

    return true

end

------------------------------------------------------------
-- GET BLOCKS AT DEPTH
------------------------------------------------------------

local function getBlocksAtDepth(depth)

    local priorityBlocks = {}
    local normalBlocks = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock")
            and not isBedrock(block) then

            local x, y, z =
                getCoordinates(block)

            if y == depth then

                local rank =
                    getPriorityRank(block)

                if rank then

                    table.insert(
                        priorityBlocks,
                        {
                            Block = block,
                            Rank = rank
                        }
                    )

                else

                    table.insert(
                        normalBlocks,
                        block
                    )

                end

            end

        end

    end

    --------------------------------------------------------
    -- LOWEST RANK = HIGHEST PRIORITY
    --------------------------------------------------------

    table.sort(
        priorityBlocks,
        function(a, b)
            return a.Rank < b.Rank
        end
    )

    return priorityBlocks, normalBlocks

end

------------------------------------------------------------
-- MINE ONE LAYER
------------------------------------------------------------

local function mineLayer(depth)

    local mined = 0

    while mined < G.Settings["Blocks Per Layer"]
        and G.Settings["Auto Mine"] do

        ----------------------------------------------------
        -- PRIORITY CAN INTERRUPT RANDOM MINING
        ----------------------------------------------------

        local globalPriority =
            findPriorityBlock()

        if globalPriority then

            mineUntilDestroyed(globalPriority)

            task.wait()

        else

            ------------------------------------------------
            -- CURRENT DEPTH
            ------------------------------------------------

            local priorityBlocks, normalBlocks =
                getBlocksAtDepth(depth)

            ------------------------------------------------
            -- PRIORITY ON THIS LAYER
            ------------------------------------------------

            if #priorityBlocks > 0 then

                local target =
                    priorityBlocks[1].Block

                if target
                    and target.Parent
                    and not isBedrock(target) then

                    mineUntilDestroyed(target)

                    mined += 1

                end

            ------------------------------------------------
            -- NORMAL RANDOM BLOCK
            ------------------------------------------------

            elseif #normalBlocks > 0 then

                local target =
                    normalBlocks[
                        math.random(
                            1,
                            #normalBlocks
                        )
                    ]

                if target
                    and target.Parent
                    and not isBedrock(target) then

                    mineUntilDestroyed(target)

                    mined += 1

                end

            else

                -- Nothing on this layer
                break

            end

        end

        task.wait()

    end

end

------------------------------------------------------------
-- RANDOM MINING BELOW -800
------------------------------------------------------------

local function randomMineDown()

    local depth = -800

    while depth > -5000
        and G.Settings["Auto Mine"] do

        ----------------------------------------------------
        -- PRIORITY FIRST
        ----------------------------------------------------

        local priority =
            findPriorityBlock()

        if priority then

            mineUntilDestroyed(priority)

        else

            ------------------------------------------------
            -- MINE SELECTED NUMBER OF BLOCKS
            ------------------------------------------------

            mineLayer(depth)

            ------------------------------------------------
            -- NEXT LAYER
            ------------------------------------------------

            depth -= 1

        end

        task.wait()

    end

end

